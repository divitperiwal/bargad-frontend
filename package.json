{
  "name": "bargad",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env turbo run dev",
    "dev:api": "bun --env-file=.env turbo run dev --filter=api",
    "dev:engine": "bun --env-file=.env turbo run dev --filter=engine",
    "dev:web": "bun --env-file=.env turbo run dev --filter=web",
    "dev:app": "bun --env-file=.env turbo run dev --filter=app",
    "build": "turbo run build",
    "format": "biome check --write && turbo run format",
    "lint": "biome check && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run lint && bun run typecheck && bun run test",
    "db:up": "docker compose up -d postgres valkey",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U bargad bargad",
    "goose": "go run github.com/pressly/goose/v3/cmd/goose@v3.29.0 -dir db/migrations postgres \"$DATABASE_URL\"",
    "db:migrate": "bun --env-file=.env run goose up",
    "db:rollback": "bun --env-file=.env run goose down",
    "db:status": "bun --env-file=.env run goose status",
    "db:test": "docker compose exec -T postgres psql -U bargad -d bargad -X -o /dev/null -f - < db/tests/guarantees.sql",
    "db:seed": "docker compose exec -T postgres psql -U bargad -d bargad -X -q -v ON_ERROR_STOP=1 -f - < db/seed.sql",
    "db:gen": "docker compose run --rm sqlc generate && bun --env-file=.env run --filter api db:pull",
    "db:new": "go run github.com/pressly/goose/v3/cmd/goose@v3.29.0 -dir db/migrations -s create"
  },
  "trustedDependencies": [
    "lefthook",
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "turbo": "^2.11.10"
  }
}
